# =============================================================================
# 公式 / 表格识别流水线 —— 一键部署变量（根目录 docker-compose.yml 使用）
#
#   cp .env.example .env
#   docker compose up -d --build
#
# 各服务目录下还有各自的 .env.example，单独部署某个服务时用那个。
# =============================================================================

# ---- 宿主机端口映射 ----
DETECTION_PORT=9000
FORMULA_PORT=9001
TABLE_PORT=9002
ROUTER_PORT=9003

LOG_LEVEL=INFO

# ---- 构建：PyTorch / Paddle ----
# 当前按 CPU 环境部署；有可用 NVIDIA GPU 且使用 GPU Compose 覆盖文件时才构建 GPU 版。
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# FlashAttention-2 仅支持 Ampere 及以上 GPU（2080 Ti 为 Turing，保持 0）
INSTALL_FLASH_ATTN=0
MODEL_PATH=/app/yolov13_formula_detection_service/models/yolov13_arxivformula_sft/yolov13l_ep5_bs16_lr_0.01.pt
# Paddle 基础镜像与变体（GPU 版安装 paddlepaddle-gpu cu126）
# PADDLE_BASE_IMAGE=nvidia/cuda:12.6.1-runtime-ubuntu22.04
# PADDLE_VARIANT=gpu
DOCKER_BASE_IMAGE=ubuntu:22.04
PADDLE_VARIANT=cpu
# 基础编排使用 CPU 版 Paddle；GPU 编排会覆盖此构建参数。
SLANET_PADDLE_VARIANT=cpu
# 国内构建加速：https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX=https://pypi.org/simple

# ---- 检测参数（router service 转发给检测服务）----
DETECT_CONF=0.25
DETECT_IOU=0.7
DETECT_IMGSZ=640
DETECT_MAX_DET=300
DETECT_BATCH=8
DETECT_DEDUP=true
DETECT_DEDUP_THR=0.8
DETECT_CROP_FORMAT=png
DETECT_CROP_QUALITY=90
DETECT_CROP_PADDING=0
# 留空 = 自动选择设备（有 GPU 用 GPU，没有用 CPU）
DETECTION_DEVICE=

# ---- router service：请求准入（多客户端并发）----
MAX_CONCURRENT_REQUESTS=2
MAX_QUEUE=64
QUEUE_TIMEOUT=30
REQUEST_TIMEOUT=3000
SESSION_TTL=1800

# ---- router service：缓冲池与消费者（两条流水线并行）----
FORMULA_WORKERS=2
TABLE_WORKERS=1
FORMULA_BATCH_SIZE=4
TABLE_BATCH_SIZE=1
BATCH_WINDOW_MS=20
POOL_MAX_SIZE=512
POOL_OVERFLOW=block
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=300
HTTP_MAX_CONNECTIONS=32

# ---- router service：类别分组 ---- ,FormulaNumber,DisplayedFormulaBlock
FORMULA_CLASSES=InlineFormula,DisplayedFormulaLine
TABLE_CLASSES=Table
FIGURE_CLASSES=Figure

# ---- 各服务资源上限 ----
DETECTION_MEMORY=12g
FORMULA_MEMORY=16g
TABLE_MEMORY=8g
ROUTER_MEMORY=2g

# ---- 各模型服务的设备与并发（留空 = 自动）----
FORMULA_DEVICE=auto
FORMULA_PREDICTOR_POOL_SIZE=
FORMULA_CPU_THREADS=
TABLE_DEVICE=auto
TABLE_PREDICTOR_POOL_SIZE=
TABLE_CPU_THREADS=
