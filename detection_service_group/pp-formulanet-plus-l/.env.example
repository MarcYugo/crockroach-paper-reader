SERVICE_PORT=9001
MODEL_NAME=PP-FormulaNet_plus-L
MODEL_DIR=/models/PP-FormulaNet_plus-L
LOCAL_MODEL_DIR=./models/PP-FormulaNet_plus-L
# auto：自动检测 GPU，没有就用 CPU（也可写死 cpu / gpu:0 / gpu:0,1）
DEVICE=auto
# 留空/注释 = 按设备自动（GPU:2，CPU:1~2）；显式设置则覆盖
PREDICTOR_POOL_SIZE=
# 留空 = 按设备自动（CPU: 核数/池大小；GPU: 4）
CPU_THREADS=
ENABLE_MKLDNN=true
MAX_QUEUE=64
QUEUE_TIMEOUT=30
DEFAULT_BATCH_SIZE=1
MAX_BATCH_SIZE=8
TEMP_DIR=/dev/shm/pp-formulanet
LOG_LEVEL=INFO
WEB_CONCURRENCY=1
# TensorRT 仅 GPU 可用；即使写成 true，CPU 模式下也会自动关闭
USE_TENSORRT=false
PRECISION=fp32
WARMUP=true

# ---- 镜像构建 ----
# 纯 CPU 机器可换成 ubuntu:22.04 + PADDLE_VARIANT=cpu（镜像更小）
DOCKER_BASE_IMAGE=ubuntu:22.04
PADDLE_VARIANT=cpu
