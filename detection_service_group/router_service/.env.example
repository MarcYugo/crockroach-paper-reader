# =============================================================================
# router_service 部署变量
#
# docker compose 会自动读取本文件，请在该目录下执行命令：
#   cd router_service
#   docker compose up -d --build
# =============================================================================

# ---- 下游三个服务 ----
# 默认 127.0.0.1 与代码默认值一致，但它在容器里指「容器自己」，不是宿主机。
# 下游跑在宿主机上时，把下面三行改成宿主地址（否则会连接被拒）：
#   DETECTION_URL=http://host.docker.internal:9000
#   FORMULA_URL=http://host.docker.internal:9001
#   TABLE_URL=http://host.docker.internal:9002
#   下游在别的机器上时，直接写那台机器的 IP，如 http://192.168.1.50:9000。
# 只有本服务以 network_mode: host 运行、或不走容器直接跑 app 时，127.0.0.1 才是对的。
DETECTION_URL=http://127.0.0.1:9000
FORMULA_URL=http://127.0.0.1:9001
TABLE_URL=http://127.0.0.1:9002

# ---- 本服务 ----
SERVICE_PORT=9003
# 宿主机映射端口（容器内监听 SERVICE_PORT）
ROUTER_PORT=9003
LOG_LEVEL=INFO

# ---- 请求准入：同时最多 2 个客户端请求，其余排队 ----
MAX_CONCURRENT_REQUESTS=2
# 排队容量上限，排满后新请求直接 503
MAX_QUEUE=64
QUEUE_TIMEOUT=30
REQUEST_TIMEOUT=300
# 会话（含缓存结果）保留时长，秒；0 = 不自动清理
SESSION_TTL=1800

# ---- 缓冲池 / 消费者 ----
# 公式识别并发（pp-formulanet-plus-l 较慢，多开几个 worker 提升吞吐）
FORMULA_WORKERS=2
# 表格识别并发（SLANet_plus 很轻量，1 个就够）
TABLE_WORKERS=1
# 消费者每次从池子里取多少条一起推理（下游单次上限 8）
FORMULA_BATCH_SIZE=4
TABLE_BATCH_SIZE=1
# 凑批等待窗口（毫秒）：越大越容易凑满一批，但单条延迟略增
BATCH_WINDOW_MS=20
# 缓存池容量
POOL_MAX_SIZE=512
# block=池满时等待空位（背压，不丢数据）；drop=池满直接判失败
POOL_OVERFLOW=block

# ---- HTTP 客户端 ----
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=300
HTTP_MAX_CONNECTIONS=32

# ---- 检测参数 ----
# 识别必须拿到框内图像，所以固定为 true（请求无法覆盖）
FORCE_RETURN_CROPS=true
DETECT_CONF=0.25
DETECT_IOU=0.7
DETECT_IMGSZ=640
DETECT_MAX_DET=300
DETECT_BATCH=8
DETECT_DEDUP=true
DETECT_DEDUP_THR=0.8
DETECT_CROP_FORMAT=png
DETECT_CROP_QUALITY=90
DETECT_CROP_PADDING=0

# ---- 类别分组（与 yolov13 的类别表一致，换成别的训练集时改这里）----
FORMULA_CLASSES=InlineFormula,DisplayedFormulaLine,FormulaNumber,DisplayedFormulaBlock
TABLE_CLASSES=Table
FIGURE_CLASSES=Figure

# ---- 镜像构建 ----
# 国内加速：https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX=https://pypi.org/simple
DOCKER_BASE_IMAGE=python:3.11-slim-bookworm
