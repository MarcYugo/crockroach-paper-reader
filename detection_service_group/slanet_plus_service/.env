# ---- 服务 ----
SERVICE_PORT=9002
LOG_LEVEL=INFO

# ---- 模型 ----
MODEL_NAME=SLANet_plus
MODEL_DIR=/models/SLANet_plus
# 宿主机模型目录（相对本目录，或写绝对路径）
LOCAL_MODEL_DIR=./models/SLANet_plus

# ---- 设备 ----
# auto：自动检测 GPU，没有就用 CPU（也可写死 cpu / gpu:0 / gpu:0,1）
DEVICE=auto
# true 时取消自动回退：DEVICE=gpu:0 但没检测到 GPU 会直接报错
DEVICE_STRICT=false

# ---- 并发与限流 ----
# 留空/注释 = 按设备自动（GPU:2；CPU:1~4，随核数）；显式设置则覆盖
PREDICTOR_POOL_SIZE=
# 留空 = 按设备自动（CPU: 核数/池大小；GPU: 4）
CPU_THREADS=
ENABLE_MKLDNN=true
MAX_QUEUE=64
QUEUE_TIMEOUT=30
DEFAULT_BATCH_SIZE=1
MAX_BATCH_SIZE=8
WEB_CONCURRENCY=1
MAX_IMAGE_MB=20
TEMP_DIR=/dev/shm/slanet-plus

# TensorRT 仅 GPU 可用；即使写成 true，CPU 模式下也会自动关闭
USE_TENSORRT=false
PRECISION=fp32
WARMUP=true

# ---- 镜像构建 ----
# 默认按 CPU 构建（镜像更小、启动更快；SLANet_plus 只有约 8MB，CPU 上也够快）。
# 要用 GPU：把下面两行换成
#   DOCKER_BASE_IMAGE=nvidia/cuda:12.6.1-runtime-ubuntu22.04
#   PADDLE_VARIANT=gpu
# 并叠加 docker-compose.gpu.yaml（或直接跑 ./docker-up.sh，它会自动判断）。
# 注意：PADDLE_VARIANT=cpu 时装的是 CPU 版 Paddle，即使叠加了 GPU 文件也用不到显卡。
DOCKER_BASE_IMAGE=ubuntu:22.04
PADDLE_VARIANT=cpu
