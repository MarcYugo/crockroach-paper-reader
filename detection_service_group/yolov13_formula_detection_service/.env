# =============================================================================
# yolov13_formula_detection_service 部署变量
#
# docker compose 会自动读取本文件，请在该目录下执行命令：
#   cd yolov13_formula_detection_service
#   docker compose up -d --build
# 若在其他目录用 -f 指定 compose 文件，需要显式指定：
#   docker compose --env-file yolov13_formula_detection_service/.env \
#     -f yolov13_formula_detection_service/docker-compose.yml up -d --build
# =============================================================================

# PyTorch 安装源：仅 docker-compose.yml（GPU）使用，用于构建镜像的 --build-arg。
#   cu121 -> https://download.pytorch.org/whl/cu121
#   cu118 -> https://download.pytorch.org/whl/cu118
#   cpu   -> https://download.pytorch.org/whl/cpu
# 注意：docker-compose.cpu.yml 固定使用 CPU 源，不受此项影响；改用 CPU 源时
#      INSTALL_FLASH_ATTN 必须为 0。
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# 服务端口：同时作为容器内监听端口（SERVICE_PORT）与宿主机映射端口。
PORT=9000

# 是否安装 wheels/ 中的 FlashAttention-2：1=安装，0=不安装。
# 仅当 TORCH_INDEX_URL 为 cu121 且 GPU 为 Ampere（SM80）及以上时才有实际收益；
# 保持 0 时推理自动回退到 PyTorch 的 scaled_dot_product_attention，功能不受影响。
INSTALL_FLASH_ATTN=0
MODEL_PATH=/app/yolov13_formula_detection_service/models/yolov13_arxivformula_sft/yolov13l_ep5_bs16_lr_0.01.pt