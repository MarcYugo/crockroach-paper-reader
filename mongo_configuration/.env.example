# 复制为 .env 后按需修改：cp .env.example .env
# 注意：.env 含明文密码，不要提交到 git（mongo_conf/.gitignore 已忽略）

# 宿主机映射端口
MONGO_PORT=27017

# 管理员账号（超管，仅用于初始化/运维）
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme

# 业务库与普通账号（应用连这个，权限仅限本库）
MONGO_APP_DB=paper
MONGO_APP_USER=paper
MONGO_APP_PASSWORD=paper123

# WiredTiger 缓存上限(GB)，单机给小一点
MONGO_CACHE_GB=0.5

# 可选：mongo-express 管理界面
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin123
