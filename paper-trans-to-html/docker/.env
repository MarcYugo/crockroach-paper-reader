# 复制为 .env 后按需修改：cp .env.example .env
# 这些值会覆盖 docker-compose.yml 里的默认值（MONGO_APP_* 仍从 mongo_configuration/.env 继承）

# 宿主机映射端口（只绑 127.0.0.1，外网访问不到）
APP_PORT=8000

# MongoDB 位置：默认连 compose 网络里的服务名 mongo
# 用外部/云端数据库时直接给整串（优先级最高）：
# MONGO_URI=mongodb://user:pass@host:27017/paper?authSource=admin
# MONGO_HOST=mongo
# MONGO_PORT=27017

# 存储后端：auto（连不上回退本地 JSON）/ mongo（连不上就启动失败）/ json
APP_STORAGE=auto

# 是否允许未登录自助注册（要暴露到公网建议设 0）
ALLOW_SIGNUP=1

# 内存
MEM_LIMIT=8g
MEM_RESERVATION=2g
MEMSWAP_LIMIT=10g
SHM_SIZE=512m
# 安装级默认 LLM（可选；每个账号还能在网页「⚙ 设置 → LLM 服务」里各自覆盖）
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ================= 配置需要与 mongo_configuration/.env 保持一致 =================
# 宿主机映射端口
MONGO_PORT=27017

# 管理员账号（超管，仅用于初始化/运维）
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme

# 业务库与普通账号（应用连这个，权限仅限本库）
MONGO_APP_DB=paper
MONGO_APP_USER=paper
MONGO_APP_PASSWORD=paper123

# WiredTiger 缓存上限(GB)，单机给小一点
MONGO_CACHE_GB=0.5

# 可选：mongo-express 管理界面
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin123
