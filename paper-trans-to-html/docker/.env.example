# 复制为 .env 后按需修改：cp .env.example .env
# 这些值会覆盖 docker-compose.yml 里的默认值（MONGO_APP_* 仍从 mongo_configuration/.env 继承）

# 宿主机映射端口（只绑 127.0.0.1，外网访问不到）
APP_PORT=8000

# MongoDB 位置：默认连 compose 网络里的服务名 mongo
# 用外部/云端数据库时直接给整串（优先级最高）：
# MONGO_URI=mongodb://user:pass@host:27017/paper?authSource=admin
# MONGO_HOST=mongo
# MONGO_PORT=27017

# 存储后端：auto（连不上回退本地 JSON）/ mongo（连不上就启动失败）/ json
APP_STORAGE=auto

# 是否允许未登录自助注册（要暴露到公网建议设 0）
ALLOW_SIGNUP=1

# 安装级默认 LLM（可选；每个账号还能在网页「⚙ 设置 → LLM 服务」里各自覆盖）
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# PDF 解析（OCR）后端：**留空 / 不写 = 用网页「⚙ 设置」里保存的值**（可随时切换）
# 填 auto / detection_service_group / surya / pymupdf = 强制锁定该后端（会覆盖网页里的选择，页面上会提示）
# （旧值 paddle / ftgroup 仍被接受，等同 auto / detection_service_group）
# PDF_PARSER_BACKEND=

# detection-service-group 公式/表格识别服务组地址（formula_table_service_group 的 router_service）
# DETECTION_SERVICE_GROUP_URL=http://host.docker.internal:9003/v1
# DETECTION_SERVICE_GROUP_TIMEOUT=300
# 回包里是否带回框内裁图（base64；前端公式渲染失败时兜底，默认开）
# DETECTION_SERVICE_GROUP_KEEP_CROPS=true

# PaddleOCR-VL 地址（保留配置：应用侧公式增强已改用 detection-service-group，可用作参考/回退）
# PADDLE_OCR_URL=http://host.docker.internal:8080/v1
# PADDLE_OCR_MODEL=PaddleOCR-VL-1.6-0.9B

# ---- 容器内存（不填 = 不限制，可用满宿主机内存；改了要 `docker compose up -d` 生效）----
# MEM_LIMIT=10g        硬上限（超过被 OOM 杀；解析大 PDF 建议不低于 4g）
# MEM_RESERVATION=2g   软保障（仅调度预留，不限制使用）
# MEMSWAP_LIMIT=12g    上限+swap 总配额；= MEM_LIMIT 即禁用 swap；-1 = 不限
# SHM_SIZE=512m        /dev/shm 大小（默认 64m，PDF 位图渲染容易撞上限）
# 查看是否被 OOM 杀：docker inspect paper-app --format '{{.State.OOMKilled}}'
