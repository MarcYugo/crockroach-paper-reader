# Copy to `.env` and adjust. Every value has a working default, so `.env` is
# only needed to change something.

# `-cu129` = CUDA 12.9; use `vllm/vllm-openai:unlimited-ocr` for CUDA 13.0.
BASE_IMAGE=vllm/vllm-openai:unlimited-ocr-cu129
IMAGE_NAME=unlimited-ocr-service:cu129

# Installs the ModelScope client into the image. Only needed when you switch
# away from the local snapshot to hub downloads (VLLM_USE_MODELSCOPE=1 or a
# MODEL_ID that looks like `owner/name`).
INSTALL_MODELSCOPE=false

# Path *inside the container* to the mounted local snapshot. The compose file
# bind-mounts ./models/Unlimited-OCR there, so host and container paths must
# match this value. Use a Hugging Face id or `PaddlePaddle/Unlimited-OCR` plus
# VLLM_USE_MODELSCOPE=1 to download from a hub instead.
MODEL_ID=/weights
# Host directory that is mounted at MODEL_ID.
LOCAL_WEIGHTS_DIR=./models/Unlimited-OCR
SERVED_MODEL_NAME=Unlimited-OCR

VLLM_PORT=9010
VLLM_DTYPE=bfloat16
# For an RTX 3080 10GB, 8192 and 0.80 are a safer operating point than the
# default 32768/0.90. If you have more free VRAM, increase them gradually.
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.80

# Caps the number of page images per prompt. Raise this for PDFs with more
# pages, or lower it if the GPU runs out of memory.
VLLM_LIMIT_MM_PER_PROMPT={"image": 16}

# Re-keys config.json's model_type to vLLM's built-in `unlimited-ocr` config
# class so the checkpoint's Transformers-v4-era remote code is not executed
# under Transformers v5. Set to `{}` only with a v5-compatible checkpoint.
VLLM_HF_OVERRIDES={"model_type": "unlimited-ocr"}

# Optional. vLLM enforces it when non-empty.
VLLM_API_KEY=
